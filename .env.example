# ============================================================================
# Copy this file to .env and fill in your actual values.
# .env is gitignored — never commit it.
# ============================================================================

# Notion (system of record)
NOTION_API_KEY=
NOTION_APPLICATIONS_DB_ID=
NOTION_CONTACTS_DB_ID=
NOTION_COMPANIES_DB_ID=

# Apify (job scraping for Workday + FAANG + universal sweep)
APIFY_TOKEN=
APIFY_UNIVERSAL_ACTOR_ID=
APIFY_WORKDAY_ACTOR_ID=

# Contact discovery
APOLLO_API_KEY=
HUNTER_API_KEY=
CONTACTOUT_API_KEY=
NEVERBOUNCE_API_KEY=

# Outreach
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
FROM_EMAIL=
FIRECRAWL_API_KEY=

# Google Drive (for resume PDFs + backups)
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_DRIVE_BACKUPS_FOLDER_ID=

# Optional: Anthropic API (only if NOT using Claude.ai interactively)
ANTHROPIC_API_KEY=

# Notifications (send failure alerts to your own inbox)
ALERT_EMAIL=

# Runtime config
TIMEZONE=America/New_York
LOG_LEVEL=INFO
